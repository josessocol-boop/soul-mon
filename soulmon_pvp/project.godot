config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Soul-Mon PvP"
run/main_scene="res://ui/main_menu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

